{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Edit(./downloads/**)",
      "Edit(./memory/**)",
      "Edit(./schedules/**)",
      "Edit(./workspace/**)",
      "Read(~/.claude/channels/telegram/inbox/**)",
      "Skill",
      "WebFetch",
      "WebSearch",
      "mcp__browser_personal",
      "mcp__browser_work",
      "mcp__plugin_telegram_telegram",
      "mcp__app"
    ],
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/channels/telegram/.env)",
      "Read(~/.agent.env)",
      "Read(~/.ssh/**)",
      "Read(~/browser-personal/**)",
      "Read(~/browser-work/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.local/state/personal-agent/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./bin/**)",
      "Edit(./app/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)",
      "Edit(~/.config/autostart/**)",
      "Edit(~/.local/state/personal-agent/**)",
      "Bash(su *)",
      "Bash(crontab -r*)",
      "Bash(crontab -e*)"
    ]
  },
  "enabledMcpjsonServers": [
    "browser_personal",
    "browser_work",
    "app"
  ],
  "enabledPlugins": {
    "telegram@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "__HOME__/agent-home/bin/statusline.sh"
  }
}
